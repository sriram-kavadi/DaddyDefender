# Threat Check Backend Environment Configuration
# Copy this file to .env and fill in your values

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# --- Database ---
# Path to the SQLite database file (relative to backend/)
DATABASE_PATH=threatcheck.db

# --- Threat Intelligence (Optional) ---
# VirusTotal API key (free tier: 4 requests/minute, 500/day)
# Get one at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# URLhaus API (optional; get a free Auth-Key at https://auth.abuse.ch/)
URLHAUS_ENABLED=true
URLHAUS_API_KEY=

# --- AI Explanation (Optional) ---
# Google Gemini API key for AI-powered explanations
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API key (alternative to Gemini)
OPENAI_API_KEY=

# --- Rate Limiting ---
# Maximum requests per minute per IP
RATE_LIMIT=30/minute

# --- Scan Settings ---
# Maximum input length in characters
MAX_INPUT_LENGTH=10000
# Maximum number of links to analyze in a message
MAX_LINKS_PER_MESSAGE=10
# Number of days to retain scan history
SCAN_RETENTION_DAYS=30
